pipeline {
    agent {
        label 'worker'
    }

    tools {
        maven 'Maven'
    }

    environment {
        my_aws_credentials = credentials('aws-access')
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/GauriZombade/student-management-app.git'
                echo 'clonning is successful'
            }
        }

        stage('Build') {
            steps {
                sh '''
                mvn clean package
                '''
                echo 'Build is successful'
            }
            post {
                success {
                    archiveArtifacts artifacts: '**/target/*.war', fingerprint: true
                }
            } 
        }

        stage('Artifact to S3') {
            steps {
                sh '''
                aws s3 cp target/*.war s3://gaurdevops.space/Artifact/student.war
                '''
            }

        }
        stage('Docker Build') {
            steps {
                sh '''
                docker build -t student:latest .
                docker images
                '''
            }
        }
        stage('Push Image to ECR'){
            steps {
                sh '''
                aws ecr get-login-password --region eu-north-1 | docker login --username AWS --password-stdin 673498377906.dkr.ecr.eu-north-1.amazonaws.com
               docker tag student:latest 673498377906.dkr.ecr.eu-north-1.amazonaws.com/student:latest
               docker push 673498377906.dkr.ecr.eu-north-1.amazonaws.com/student:latest
                '''
            }
        }
        stage('Deploy to kubernetes') {
            steps {
               sh '''
                aws eks update-kubeconfig --name my-cluster-eks --region eu-north-1
                kubectl apply -f k8s/deployment.yaml
                kubectl apply -f k8s/service.yaml
                kubectl get pods
                kubectl get svc
                sleep 30 
                kubectl get pods
                kubectl get svc -o wide
                '''
            }
        }
    }

}
 